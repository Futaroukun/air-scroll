<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/bubbleCard"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:background="@drawable/overlay_window_bg"
        android:clipToOutline="true">

        <!-- Camera Preview (mirrored) -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tracking Status Overlay Indicator -->
        <View
            android:id="@+id/indicatorDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/ic_bubble_bg" />

        <!-- Close overlay button -->
        <TextView
            android:id="@+id/btnCloseOverlay"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="#80000000"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Gesture Feedback Text -->
        <TextView
            android:id="@+id/tvGestureFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="Ready"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </FrameLayout>
</FrameLayout>
